<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <h1>ALL FACULTY DETAILS</h1>

    <div>
        <% data.forEach((ele)=>{%>

            <div>

                <p><%=ele.name%></p>
                <p><%=ele.experience%></p>
                <p><%=ele.email%></p>

                <a href="/editdata/<%=ele._id%>">EDIT</a>
                <a href="/deleteData/<%=ele._id%>">DELETE</a>
                
            </div>
        <%})%>
    </div>
    
</body>
</html>