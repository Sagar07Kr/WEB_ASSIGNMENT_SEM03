<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <div>
        <% data.forEach((ele)=>{%>
           
           <h1>Details of <%=ele.name%></h1> 
           
            <div>
                <p> <%=ele.name%></p>
                <p> <%=ele.batch%></p>
                <p> <%=ele.email%></p>
                <p> <%=ele.phoneno%></p>
                <p> <%=ele.post%></p>
            </div>

        <%})%>
    </div>
    
</body>
</html>