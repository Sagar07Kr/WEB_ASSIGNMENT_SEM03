<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
<form action="/update/<%=data._id%>" method="POST">
      
    <input type="text" name="name" value="<%=data.name%>">
